cff-version: 1.2.0
message: >-
  If you use RABET in academic work, please cite the RABET paper given under
  preferred-citation. It is a preprint under peer review; the entry will be
  updated once the paper is published.
title: "RABET — Real-time Animal Behavior Event Tagger"
abstract: >
  RABET is a cross-platform desktop application for behavioural annotation of
  animal videos. Researchers play back recordings, tag behaviours with
  configurable keyboard shortcuts in real time, visualise event timelines and
  export per-session and per-interval summaries for downstream statistical
  analysis. Version 1.4.0 adds explicit state and point behaviour types, bout
  analysis, and first-order transition analysis.
authors:
  - family-names: "Mitsui"
    given-names: "Koshiro"
    orcid: "https://orcid.org/0009-0009-0556-3906"
type: software
version: "1.4.4"
date-released: "2026-10-16"
license: MIT
repository-code: "https://github.com/mi2e-K/RABET"
url: "https://github.com/mi2e-K/RABET"
# RABET is also archived on Zenodo, which is not linked to the GitHub
# releases. Its DOIs identify that archive:
#   - a "concept DOI" that resolves to the latest version on Zenodo
#     (10.5281/zenodo.15313025), and
#   - optional "version DOI" records specific to archived releases.
# To cite RABET, use the paper under preferred-citation below.
identifiers:
  - type: doi
    value: "10.5281/zenodo.15313025"
    description: "Zenodo concept DOI - resolves to the latest RABET release."
  - type: doi
    value: "10.5281/zenodo.15313026"
    description: "Zenodo version DOI for RABET v1.0.0."
keywords:
  - ethology
  - behavioural-annotation
  - video-coding
  - neuroscience
  - desktop-application
  - python
  - qt
preferred-citation:
  type: article
  status: preprint
  authors:
    - family-names: "Mitsui"
      given-names: "Koshiro"
      orcid: "https://orcid.org/0009-0009-0556-3906"
    - family-names: "Wakatsuki"
      given-names: "Moe"
    - family-names: "Takahashi"
      given-names: "Aki"
  title: "Protocol For Structured Ethological Coding of Mouse Aggressive Behavior Using RABET, The Real-Time Animal Behavior Event Tagger"
  journal: "SSRN"
  year: 2026
  month: 8
  doi: "10.2139/ssrn.7320524"
  url: "https://ssrn.com/abstract=7320524"
  notes: "Preprint, under peer review."
